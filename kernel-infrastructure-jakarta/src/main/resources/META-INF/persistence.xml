<?xml version="1.0" encoding="UTF-8"?>
<persistence xmlns="https://jakarta.ee/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence https://jakarta.ee/xml/ns/persistence/persistence_3_2.xsd"
             version="3.2">
    <persistence-unit name="logixone-core-pu" transaction-type="JTA">
        <jta-data-source>java:/jdbc/LogixoneCoreDS</jta-data-source>
        <class>py.com.logixone.kernel.infrastructure.jakarta.persistence.CompanyEntity</class>
        <class>py.com.logixone.kernel.infrastructure.jakarta.persistence.PluginActivationEntity</class>
        <class>py.com.logixone.kernel.infrastructure.jakarta.persistence.PluginActivationKey</class>
        <class>py.com.logixone.kernel.infrastructure.jakarta.persistence.AppUserEntity</class>
        <class>py.com.logixone.kernel.infrastructure.jakarta.persistence.CompanyMembershipEntity</class>
        <class>py.com.logixone.kernel.infrastructure.jakarta.persistence.CompanyMembershipKey</class>
        <class>py.com.logixone.kernel.infrastructure.jakarta.persistence.SecurityRoleEntity</class>
        <class>py.com.logixone.kernel.infrastructure.jakarta.persistence.RolePermissionEntity</class>
        <class>py.com.logixone.kernel.infrastructure.jakarta.persistence.RolePermissionKey</class>
        <class>py.com.logixone.kernel.infrastructure.jakarta.persistence.MembershipRoleEntity</class>
        <class>py.com.logixone.kernel.infrastructure.jakarta.persistence.MembershipRoleKey</class>
        <class>py.com.logixone.kernel.infrastructure.jakarta.persistence.SystemRoleEntity</class>
        <class>py.com.logixone.kernel.infrastructure.jakarta.persistence.SystemRolePermissionEntity</class>
        <class>py.com.logixone.kernel.infrastructure.jakarta.persistence.SystemRolePermissionKey</class>
        <class>py.com.logixone.kernel.infrastructure.jakarta.persistence.AppUserSystemRoleEntity</class>
        <class>py.com.logixone.kernel.infrastructure.jakarta.persistence.AppUserSystemRoleKey</class>
        <class>py.com.logixone.kernel.infrastructure.jakarta.persistence.AuditEventEntity</class>
        <exclude-unlisted-classes>true</exclude-unlisted-classes>
        <shared-cache-mode>NONE</shared-cache-mode>
        <validation-mode>NONE</validation-mode>
        <properties>
            <property name="jakarta.persistence.schema-generation.database.action" value="none"/>
            <property name="jakarta.persistence.schema-generation.scripts.action" value="none"/>
            <property name="hibernate.hbm2ddl.auto" value="validate"/>
            <property name="hibernate.default_schema" value="core"/>
            <property name="hibernate.show_sql" value="false"/>
            <property name="hibernate.format_sql" value="false"/>
            <property name="hibernate.cache.use_second_level_cache" value="false"/>
            <property name="hibernate.cache.use_query_cache" value="false"/>
        </properties>
    </persistence-unit>
</persistence>
