# Identidad estable de la composicion local.
COMPOSE_PROJECT_NAME=logixone

# Publicacion HTTP solo en loopback por defecto.
LOGIXONE_HTTP_BIND=127.0.0.1
LOGIXONE_HTTP_PORT=8080

# Keycloak se publica solo en loopback. El hostname .localhost es resoluble tanto
# por el navegador como por el alias de la red Compose `identity`.
LOGIXONE_KEYCLOAK_BIND=127.0.0.1
LOGIXONE_KEYCLOAK_PORT=8180
LOGIXONE_KEYCLOAK_PUBLIC_URL=http://keycloak.localhost:8180
LOGIXONE_KEYCLOAK_PROXY_HEADERS=xforwarded
LOGIXONE_KEYCLOAK_ADMIN_USER=logixone-admin

# Configuracion no sensible de PostgreSQL.
LOGIXONE_DB_NAME=logixone
LOGIXONE_DB_USER=logixone

# Debe ser unico por instancia WildFly cuando haya mas de un nodo.
LOGIXONE_TX_NODE_ID=logixone-local-1

# Ruta al archivo local que contiene unicamente la contrasena.
# El archivo real debe permanecer bajo .tools/ y no se versiona.
LOGIXONE_POSTGRES_PASSWORD_FILE=../../.tools/secrets/postgres-password.txt
LOGIXONE_KEYCLOAK_ADMIN_PASSWORD_FILE=../../.tools/secrets/keycloak-admin-password.txt
LOGIXONE_OIDC_CLIENT_SECRET_FILE=../../.tools/secrets/oidc-client-secret.txt
LOGIXONE_DEMO_USER_PASSWORD_FILE=../../.tools/secrets/demo-user-password.txt

# Contrato OIDC no sensible. Al cambiar host o puerto público de la aplicación,
# actualizar juntas estas URI y volver a crear el realm local cuando corresponda.
LOGIXONE_OIDC_PROVIDER_URL=http://keycloak.localhost:8180/realms/logixone
LOGIXONE_OIDC_CLIENT_ID=logixone-web
LOGIXONE_OIDC_REDIRECT_URI=http://localhost:8080/logixone/*
LOGIXONE_OIDC_WEB_ORIGIN=http://localhost:8080
LOGIXONE_OIDC_POST_LOGOUT_REDIRECT_URI=http://localhost:8080/logixone/faces/app/index.xhtml
# Cambiar a true únicamente detrás de un proxy confiable que sanee X-Forwarded-*.
LOGIXONE_PROXY_ADDRESS_FORWARDING=false

# Bootstrap interno one-shot. Mantener false hasta que exista la empresa exacta.
# Al habilitarlo, todos los campos siguientes son obligatorios salvo display name.
LOGIXONE_SECURITY_BOOTSTRAP_ENABLED=false
LOGIXONE_SECURITY_BOOTSTRAP_SUBJECT=
LOGIXONE_SECURITY_BOOTSTRAP_DISPLAY_NAME=
LOGIXONE_SECURITY_BOOTSTRAP_COMPANY_ID=
LOGIXONE_SECURITY_BOOTSTRAP_CUSTOMIZATION_PLUGIN=
LOGIXONE_SECURITY_BOOTSTRAP_ROLE_CODE=
LOGIXONE_SECURITY_BOOTSTRAP_ROLE_NAME=
LOGIXONE_SECURITY_BOOTSTRAP_PERMISSIONS=

# Primer administrador global del kernel. Permanece cerrado hasta J11-S4-03,
# cuando exista el adaptador JPA/JTA; habilitarlo antes hará fallar el arranque.
# No contiene empresa, password, token ni roles de Keycloak.
LOGIXONE_SYSTEM_AUTHORITY_BOOTSTRAP_ENABLED=false
LOGIXONE_SYSTEM_AUTHORITY_BOOTSTRAP_SUBJECT=
LOGIXONE_SYSTEM_AUTHORITY_BOOTSTRAP_DISPLAY_NAME=
LOGIXONE_SYSTEM_AUTHORITY_BOOTSTRAP_ROLE_CODE=kernel_administrator
LOGIXONE_SYSTEM_AUTHORITY_BOOTSTRAP_ROLE_NAME=Administrador global del kernel
LOGIXONE_SYSTEM_AUTHORITY_BOOTSTRAP_PERMISSIONS=kernel.company.manage,kernel.plugin.manage,kernel.security.manage,kernel.audit.view,kernel.system_administration.manage

# Aprovisionamiento cerrado de la demo técnica. No contiene passwords.
LOGIXONE_DEMO_PROVISIONING_ENABLED=false
LOGIXONE_DEMO_SUBJECT_NO_COMPANY=10000000-0000-4000-8000-000000000001
LOGIXONE_DEMO_SUBJECT_SINGLE_COMPANY=10000000-0000-4000-8000-000000000002
LOGIXONE_DEMO_SUBJECT_MULTIPLE_COMPANIES=10000000-0000-4000-8000-000000000003

# Tags locales para desarrollo. En ambientes compartidos se sustituyen por
# referencias inmutables del registro: repositorio@sha256:digest.
LOGIXONE_APP_IMAGE=logixone/app:j11-s3-08-visual-candidate
LOGIXONE_MIGRATOR_IMAGE=logixone/migrator:j11-s3-08-visual-candidate
