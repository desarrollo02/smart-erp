<?xml version="1.0" encoding="UTF-8"?>
<persistence xmlns="https://jakarta.ee/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence https://jakarta.ee/xml/ns/persistence/persistence_3_2.xsd"
             version="3.2">
    <persistence-unit name="logixone-business-partners-pu" transaction-type="JTA">
        <jta-data-source>java:/jdbc/LogixoneCoreDS</jta-data-source>
        <class>py.com.logixone.plugins.businesspartners.infrastructure.persistence.BusinessPartnerEntity</class>
        <class>py.com.logixone.plugins.businesspartners.infrastructure.persistence.BusinessPartnerEntityId</class>
        <class>py.com.logixone.plugins.businesspartners.infrastructure.persistence.BusinessPartnerRoleEntity</class>
        <class>py.com.logixone.plugins.businesspartners.infrastructure.persistence.BusinessPartnerRoleEntityId</class>
        <class>py.com.logixone.plugins.businesspartners.infrastructure.persistence.BusinessPartnerIdentificationEntity</class>
        <class>py.com.logixone.plugins.businesspartners.infrastructure.persistence.BusinessPartnerAddressEntity</class>
        <class>py.com.logixone.plugins.businesspartners.infrastructure.persistence.BusinessPartnerChannelEntity</class>
        <class>py.com.logixone.plugins.businesspartners.infrastructure.persistence.BusinessPartnerContactEntity</class>
        <class>py.com.logixone.plugins.businesspartners.infrastructure.persistence.BusinessPartnerContactChannelEntity</class>
        <class>py.com.logixone.plugins.businesspartners.infrastructure.persistence.BusinessPartnerDetailEntityId</class>
        <class>py.com.logixone.plugins.businesspartners.infrastructure.persistence.BusinessPartnerContactChannelEntityId</class>
        <class>py.com.logixone.plugins.businesspartners.infrastructure.persistence.BusinessPartnerDefinitionEntity</class>
        <class>py.com.logixone.plugins.businesspartners.infrastructure.persistence.BusinessPartnerDefinitionEntityId</class>
        <class>py.com.logixone.plugins.businesspartners.infrastructure.persistence.BusinessPartnerDefinitionRevisionEntity</class>
        <class>py.com.logixone.plugins.businesspartners.infrastructure.persistence.BusinessPartnerDefinitionRevisionEntityId</class>
        <exclude-unlisted-classes>true</exclude-unlisted-classes>
        <shared-cache-mode>NONE</shared-cache-mode>
        <validation-mode>NONE</validation-mode>
        <properties>
            <property name="jakarta.persistence.schema-generation.database.action" value="none"/>
            <property name="jakarta.persistence.schema-generation.scripts.action" value="none"/>
            <property name="hibernate.hbm2ddl.auto" value="validate"/>
            <property name="hibernate.default_schema" value="plg_business_partners"/>
            <property name="hibernate.show_sql" value="false"/>
            <property name="hibernate.format_sql" value="false"/>
            <property name="hibernate.cache.use_second_level_cache" value="false"/>
            <property name="hibernate.cache.use_query_cache" value="false"/>
        </properties>
    </persistence-unit>
</persistence>
